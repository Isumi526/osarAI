# ステージング環境（本番と完全分離）。実ファイル名は .env.staging.local（gitignore 対象・公開リポに入れない）。
# 人が値を貼る → `node scripts/staging-setup.mjs` が migration 適用・Vercel Preview env 設定・preview デプロイ・テストユーザー作成を行う。

# --- Supabase staging プロジェクト（新規作成したもの。本番 apiagxfbazxmdqcbynxk は禁止・スクリプトが拒否する） ---
STAGING_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Dashboard > Connect > Direct connection（postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres）
STAGING_SUPABASE_DB_URL=

# --- Stripe（テストモードのキー。sk_test_ / pk_test_ / テストモードの Price ID） ---
STAGING_STRIPE_SECRET_KEY=sk_test_
STAGING_STRIPE_PUBLISHABLE_KEY=pk_test_
STAGING_STRIPE_PRICE_LIGHT=price_
STAGING_STRIPE_PRICE_STANDARD=price_
STAGING_STRIPE_PRICE_PRO=price_
# Stripe Dashboard(テスト) > Webhooks で「<web staging URL>/api/stripe/webhook」を登録して得る whsec_（後からでも可）
STAGING_STRIPE_WEBHOOK_SECRET=

# --- Gemini（本番と同じキーを流用してよい・API利用のみ） ---
STAGING_GEMINI_API_KEY=

# --- 固定エイリアス（任意・空なら Vercel の deployment URL をそのまま使う） ---
STAGING_WEB_ALIAS=osarai-web-staging.vercel.app
STAGING_MOBILE_ALIAS=osarai-app-staging.vercel.app

# --- ステージングのテストユーザー（スクリプトが signup + Light/trialing を付与） ---
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
STAGING_TEST_DISPLAY_NAME=
